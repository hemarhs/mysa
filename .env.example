# ---------------------------------------------------------------------------
# Mysa - environment configuration
# Copy this file to `.env.local` and fill in real values.
# ---------------------------------------------------------------------------

# Neon Postgres pooled connection string.
# Neon Console -> your project -> Connection Details -> "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/mysa?sslmode=require"

# Secret used to sign admin session JWTs.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public site origin, used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="https://mysa.cafe"

# Serve photographs from /public instead of Unsplash.
# Run `npm run photos:fetch` first, then `npm run db:seed` again.
NEXT_PUBLIC_LOCAL_PHOTOS="0"

# ---------------------------------------------------------------------------
# Image uploads (admin panel)
# Provider is "blob" (Vercel Blob) or "local" (filesystem, development only).
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="blob"

# Vercel Blob read/write token. Vercel Dashboard -> Storage -> Blob -> Tokens.
# Automatically injected when deployed on Vercel with a Blob store connected.
BLOB_READ_WRITE_TOKEN=""
